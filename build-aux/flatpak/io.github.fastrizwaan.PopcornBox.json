{
    "id": "io.github.fastrizwaan.PopcornBox",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "popcornbox",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--filesystem=xdg-pictures/PopcornBox Screenshots:create",
        "--filesystem=/media:ro",
        "--filesystem=/mnt:ro",
        "--filesystem=/var/mnt:ro",
        "--filesystem=/run/media:ro",
        "--filesystem=xdg-run/pipewire-0:ro",
        "--filesystem=xdg-run/gvfs",
        "--filesystem=xdg-run/gvfsd",
        "--talk-name=org.gtk.vfs.*",
        "--env=LC_NUMERIC=C"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a",
        "/lib/cmake"
    ],
    "cleanup-commands": [
        "python3 -m compileall --invalidation-mode=unchecked-hash /app"
    ],
    "modules": [
        {
            "name": "libmpv",
            "cleanup": [
                "/share/applications",
                "/share/bash-completion",
                "/share/doc",
                "/share/icons",
                "/share/zsh"
            ],
            "buildsystem": "meson",
            "config-opts": [
                "-Dlibmpv=true",
                "-Dbuild-date=false",
                "-Dalsa=disabled",
                "-Dlua=enabled"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/mpv-player/mpv/archive/v0.41.0.tar.gz",
                    "sha256": "ee21092a5ee427353392360929dc64645c54479aefdb5babc5cfbb5fad626209",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 5348,
                        "stable-only": true,
                        "url-template": "https://github.com/mpv-player/mpv/archive/v$version.tar.gz",
                        "is-important": true
                    }
                },
                {
                    "type": "patch",
                    "path": "fix-screenshots.diff"
                }
            ],
            "modules": [
                "shared-modules/lua5.1/lua-5.1.5.json",
                {
                    "name": "libass",
                    "config-opts": [
                        "--disable-static"
                    ],
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://github.com/libass/libass/releases/download/0.17.5/libass-0.17.5.tar.xz",
                            "sha256": "2dca25c0e0c837ddf00b52011b3f82cac1e4ddd3ad018227806b0c2288864acc",
                            "x-checker-data": {
                                "type": "anitya",
                                "project-id": 1560,
                                "stable-only": true,
                                "url-template": "https://github.com/libass/libass/releases/download/$version/libass-$version.tar.xz"
                            }
                        }
                    ]
                },
                {
                    "name": "uchardet",
                    "buildsystem": "cmake-ninja",
                    "config-opts": [
                        "-DCMAKE_BUILD_TYPE=Release",
                        "-DBUILD_STATIC=0",
                        "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
                    ],
                    "cleanup": [
                        "/bin"
                    ],
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://www.freedesktop.org/software/uchardet/releases/uchardet-0.0.8.tar.xz",
                            "sha256": "e97a60cfc00a1c147a674b097bb1422abd9fa78a2d9ce3f3fdcc2e78a34ac5f0",
                            "x-checker-data": {
                                "type": "anitya",
                                "project-id": 9265,
                                "stable-only": true,
                                "url-template": "https://www.freedesktop.org/software/uchardet/releases/uchardet-$version.tar.xz"
                            }
                        }
                    ]
                },
                {
                    "name": "libplacebo",
                    "buildsystem": "meson",
                    "config-opts": [
                        "-Ddemos=false"
                    ],
                    "sources": [
                        {
                            "type": "git",
                            "url": "https://github.com/haasn/libplacebo.git",
                            "commit": "cee9b076f2c63104ccfd497fa79c39a867293ec4",
                            "tag": "v7.360.1",
                            "x-checker-data": {
                                "type": "git",
                                "tag-pattern": "^v([\\d.]+)$"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "deno",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm755 deno /app/bin/deno"
            ],
            "sources": [
                {
                    "type": "file",
                    "only-arches": [
                        "x86_64"
                    ],
                    "url": "https://github.com/denoland/deno/releases/download/v2.9.8/deno-x86_64-unknown-linux-gnu.zip",
                    "sha256": "e890975bc2549807bbcc0b584ffafda72cc7c93349dd99c80483dd784f6c4609",
                    "dest-filename": "deno.zip",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/denoland/deno/releases/latest",
                        "version-query": ".name | sub(\"^v\"; \"\")",
                        "timestamp-query": ".published_at",
                        "url-query": ".assets[] | select(.name == \"deno-x86_64-unknown-linux-gnu.zip\") | .browser_download_url"
                    }
                },
                {
                    "type": "file",
                    "only-arches": [
                        "aarch64"
                    ],
                    "url": "https://github.com/denoland/deno/releases/download/v2.9.8/deno-aarch64-unknown-linux-gnu.zip",
                    "sha256": "d49596c20b9788cf8f5d8ddf644103d4bde56ed239753f0bdb92ba9361d51905",
                    "dest-filename": "deno.zip",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/denoland/deno/releases/latest",
                        "version-query": ".name | sub(\"^v\"; \"\")",
                        "timestamp-query": ".published_at",
                        "url-query": ".assets[] | select(.name == \"deno-aarch64-unknown-linux-gnu.zip\") | .browser_download_url"
                    }
                },
                {
                    "type": "shell",
                    "commands": [
                        "unzip deno.zip"
                    ]
                }
            ]
        },
        {
            "name": "wasmtime",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --no-index --no-deps --prefix=/app wasmtime-*.whl"
            ],
            "sources": [
                {
                    "type": "file",
                    "only-arches": [
                        "x86_64"
                    ],
                    "url": "https://files.pythonhosted.org/packages/d5/9d/97c109d4a25c716c4045644398d7e684e1d4fa5ec6c99412b5cba35a9a98/wasmtime-50.0.1-py3-none-manylinux1_x86_64.whl",
                    "sha256": "cc14c3a17654e0394e0225b11813532ef0cd7bd1e222a0c5494cdedaabeddac4"
                },
                {
                    "type": "file",
                    "only-arches": [
                        "aarch64"
                    ],
                    "url": "https://files.pythonhosted.org/packages/8e/c4/58709b73e613e5366e4783537e2a861272d95f500c43fddf9b378d98415a/wasmtime-50.0.1-py3-none-manylinux2014_aarch64.whl",
                    "sha256": "675484e525c028dc02762b777f1db4477ea70caa3fec6775426daff4d64edfb1"
                }
            ]
        },
        {
            "name": "pycparser",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --no-index --no-deps --prefix=/app pycparser-*.whl"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/b6/ae/315bbeee126a769cbde43cf4908acb4b40408d8bf8bbf334dd7368d8dadf/pycparser-3.12-py3-none-any.whl",
                    "sha256": "a076f3f489b39b43ed13563a1dafe42447445bec2e294154ec5c57fcdda4c85e"
                }
            ]
        },
        {
            "name": "cffi",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --no-index --no-deps --prefix=/app cffi-*.whl"
            ],
            "sources": [
                {
                    "type": "file",
                    "only-arches": [
                        "x86_64"
                    ],
                    "url": "https://files.pythonhosted.org/packages/e9/02/4e7d553a7ac4b4238b38b3c1b80d486e9d4436f8d2acbf87a0997fe3f402/cffi-2.1.1-cp314-cp314-manylinux2014_x86_64.manylinux_2_17_x86_64.whl",
                    "sha256": "b0431303acaea1089ad4b3e9ce4e6518193def1118d4073ca848635ee4ea2e96"
                },
                {
                    "type": "file",
                    "only-arches": [
                        "aarch64"
                    ],
                    "url": "https://files.pythonhosted.org/packages/67/b8/b42132ca113dc567d37684437b46ca1dafc885902b02a110a02d5b511857/cffi-2.1.1-cp314-cp314-manylinux2014_aarch64.manylinux_2_17_aarch64.whl",
                    "sha256": "58acb8ab8e295e6c5ea12f888cbb13cf21511ef2a3303a23f4325c29d17fe5c1"
                }
            ]
        },
        {
            "name": "cryptography",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --no-index --no-deps --prefix=/app cryptography-*.whl"
            ],
            "sources": [
                {
                    "type": "file",
                    "only-arches": [
                        "x86_64"
                    ],
                    "url": "https://files.pythonhosted.org/packages/bf/f1/1c1f6874e8550cfddd4b688ceb38cefb6ed15ceed224d56f133f3d88c214/cryptography-50.0.2-cp39-abi3-manylinux2014_x86_64.manylinux_2_17_x86_64.whl",
                    "sha256": "ee247f5c245c9a2fe7c8e2214e295918838e44e00a45a6718451e4004219e767"
                },
                {
                    "type": "file",
                    "only-arches": [
                        "aarch64"
                    ],
                    "url": "https://files.pythonhosted.org/packages/d5/8d/6d585339bedf85d45044c85d8412dac53f2bb6f918e8b7777efba1787844/cryptography-50.0.2-cp39-abi3-manylinux2014_aarch64.manylinux_2_17_aarch64.whl",
                    "sha256": "c5e67125c7dca78d199ec4e116aa93dbb83494808ecbb8211a2cb09b1bf41dbd"
                }
            ]
        },
        {
            "name": "yt-dlp-ejs",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --prefix=/app yt_dlp_ejs*.whl"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/e3/bd/520769863744b669440a924271a6159ddd82ad5ae26b4ac4d4b69e9f8d44/yt_dlp_ejs-0.8.0-py3-none-any.whl",
                    "sha256": "79300e5fca7f937a1eeede11f0456862c1b41107ce1d726871e0207424f4bdb4",
                    "x-checker-data": {
                        "is-important": true,
                        "type": "pypi",
                        "name": "yt-dlp-ejs",
                        "packagetype": "bdist_wheel"
                    }
                }
            ]
        },
        {
            "name": "yt-dlp",
            "no-autogen": true,
            "no-make-install": true,
            "make-args": [
                "yt-dlp",
                "PYTHON=/usr/bin/python3"
            ],
            "post-install": [
                "install yt-dlp /app/bin"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/yt-dlp/yt-dlp/releases/download/2026.10.26/yt-dlp.tar.gz",
                    "sha256": "21f942d258d25cc4e60b4982a25c423460f0bebb835f38e6dfd1fcb140087f95",
                    "x-checker-data": {
                        "is-important": true,
                        "type": "json",
                        "url": "https://api.github.com/repos/yt-dlp/yt-dlp/releases/latest",
                        "version-query": ".tag_name",
                        "url-query": ".assets[] | select(.name==\"yt-dlp.tar.gz\") | .browser_download_url"
                    }
                }
            ]
        },
        {
            "name": "boost",
            "buildsystem": "simple",
            "build-commands": [
                "./bootstrap.sh --prefix=/app --with-python=python3",
                "./b2 stage -j $FLATPAK_BUILDER_N_JOBS variant=release threading=multi link=shared debug-symbols=off",
                "./b2 install --prefix=/app variant=release threading=multi link=shared debug-symbols=off"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://archives.boost.io/release/1.92.0/source/boost_1_92_0.tar.bz2",
                    "sha256": "5c1d40cb8e19adbf740a4ec2da35b3e58f3f5804b1dce44deb53df72193cbc6c"
                }
            ]
        },
        {
            "name": "libtorrent",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DCMAKE_CXX_STANDARD=17",
                "-Dpython-bindings=ON",
                "-Dpython-egg-info=ON",
                "-Dboost-python-module-name=python"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/arvidn/libtorrent/releases/download/v2.0.15/libtorrent-rasterbar-2.0.15.tar.gz",
                    "sha256": "5e2e79129823b7ea48721164c32b5aaf83d3fd733b5502100f6705b29f27bb02"
                }
            ]
        },
        {
            "name": "python-mpv",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --no-index --no-build-isolation --find-links=. --prefix=/app python_mpv"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/77/bc/6aa34c8805ff62e2fefc7d171563c60598aac215d5241186031a2c839935/python_mpv-1.0.8.tar.gz",
                    "sha256": "017fa359da059c831a94c419083491903e6d2f7c81b9841c33c196cabf4b3fe3"
                }
            ]
        },
        {
            "name": "popcornbox",
            "builddir": true,
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "dir",
                    "path": "../../",
                    "skip": [
                        ".git",
                        ".flatpak-builder",
                        "build-dir",
                        "NuvioDesktop",
                        "NuvioMobile-Enhanced",
                        "_build",
                        ".ruff_cache",
                        "screenshots"
                    ]
                }
            ]
        }
    ]
}